    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.10",
    "vite-plugin-vue-devtools": "^8.1.1",
